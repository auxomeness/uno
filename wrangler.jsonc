{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "uno-party",
  "main": "worker/index.ts",
  "compatibility_date": "2026-11-16",
  "assets": { "directory": "./dist", "binding": "ASSETS", "not_found_handling": "single-page-application" },
  "durable_objects": {
    "bindings": [
      { "name": "DIRECTORY", "class_name": "Directory" },
      { "name": "ROOMS", "class_name": "GameRoom" }
    ]
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Directory", "GameRoom"] }],
  "observability": { "enabled": true, "logs": { "enabled": true, "head_sampling_rate": 1 }, "traces": { "enabled": true, "head_sampling_rate": 0.05 } }
}
